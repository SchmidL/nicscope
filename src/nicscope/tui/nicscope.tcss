/* nicscope — a terminal on a measurement host is often small and often has no
   colour theme. The layout stays readable at 80x24 and uses colour only to
   carry meaning, never for decoration. */

Screen {
    layers: base overlay;
}

#status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#status.busy {
    background: $warning-darken-2;
    color: $text;
}

#status.blink {
    background: $accent-darken-2;
    color: $text;
}

TabbedContent {
    height: 1fr;
}

/* ---------------------------------------------------------------- ports -- */
#ports-table {
    height: 45%;
    min-height: 6;
}

#ports-detail {
    height: 1fr;
    border-top: solid $primary;
    padding: 0 1;
    overflow-y: auto;
}

/* --------------------------------------------------------------- timing -- */
#timing-head {
    height: auto;
    padding: 0 1;
}

#timing-table {
    height: auto;
    max-height: 60%;
}

#timing-detail {
    height: 1fr;
    border-top: solid $primary;
    padding: 0 1;
    overflow-y: auto;
}

/* ------------------------------------------------------------- topology -- */
#topology-tree {
    height: 1fr;
    padding: 0 1;
}

#topology-legend {
    height: auto;
    padding: 0 1;
    border-top: solid $primary;
    color: $text-muted;
}

/* --------------------------------------------------------------- export -- */
#export-body {
    padding: 1 2;
    height: auto;
}

#export-body Label {
    padding: 1 0 0 0;
}

#export-result {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

/* --------------------------------------------------------------- modals -- */
HelpScreen, LabelScreen {
    align: center middle;
}

#help-box {
    width: 74;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}

#label-box {
    width: 70;
    max-width: 90%;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#label-box Label {
    padding: 0 0 1 0;
}
